# Copy to `.env` and edit. `.env` is gitignored.
#
# IMPORTANT — how these are actually read
#
# The Tauri CLI does NOT load this file into the Rust process (verified: a
# variable set only here never reaches the app). Only Vite reads `.env`, and
# only for `VITE_`-prefixed variables, which are exposed to the frontend via
# `import.meta.env`.
#
# So the ATLAS_* variables below must be exported into the shell that launches
# the app:
#
#   set -a && source .env && set +a
#   pnpm tauri dev
#
# Or prefixed inline for a single run:
#
#   ATLAS_DB_PATH=./dev.db pnpm tauri dev


# ─── Database ────────────────────────────────────────────────────────────────

# Absolute or relative path to the SQLite file. Leave unset to use the OS
# app-data directory, which is what a normal install uses:
#
#   macOS    ~/Library/Application Support/<bundle identifier>/library.db
#   Linux    ~/.local/share/<bundle identifier>/library.db
#   Windows  %APPDATA%\<bundle identifier>\library.db
#
# Set it to keep the database inside the repo while developing, which makes it
# trivial to open in TablePlus and to throw away. Parent directories are
# created automatically.
#
# There is no host, port, user or password: SQLite is a file, not a server.
#
# ATLAS_DB_PATH=./dev.db


# ─── Seeding ─────────────────────────────────────────────────────────────────

# Any non-empty value makes the app seed the database and exit immediately
# instead of opening a window. Equivalent to passing `--seed` to the binary.
# The `pnpm seed` script sets this for you, so you rarely need it here.
#
# ATLAS_SEED=1


# ─── Frontend ────────────────────────────────────────────────────────────────

# Vite only exposes variables prefixed with VITE_ to the frontend bundle.
# Never put secrets here: anything with this prefix is compiled into the
# shipped JavaScript and is readable by anyone with the app.
#
# VITE_EXAMPLE_FLAG=false
